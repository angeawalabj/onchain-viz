# Clés API optionnelles — sans elles, des données de démo sont affichées.
# Ces variables sont saisies dans l'UI, pas ici (stockage localStorage).
# Ce fichier sert uniquement de documentation.

# Etherscan — wallet graph (transactions)
# Obtenir : https://etherscan.io/apis
NEXT_PUBLIC_ETHERSCAN_KEY=

# Alchemy — contract activity (eth_getLogs)
# Obtenir : https://dashboard.alchemy.com
NEXT_PUBLIC_ALCHEMY_KEY=

# The Graph — DeFi liquidity (Uniswap V3, Aave)
# Obtenir : https://thegraph.com/studio
NEXT_PUBLIC_GRAPH_API_KEY=
